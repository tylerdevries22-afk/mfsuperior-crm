{
  "expo": {
    "name": "MF Superior Products",
    "slug": "mfsuperior-products",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/mf-logo-mark.png",
    "scheme": "mfsuperior",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0F0C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mfsuperior.products",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mfsuperior.products",
      "adaptiveIcon": {
        "backgroundColor": "#111315",
        "foregroundImage": "./assets/brand/mf-logo-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/brand/mf-logo-mark.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MF Superior Products to attach freight photos.",
          "cameraPermission": "Allow MF Superior Products to take proof-of-delivery photos when you choose to."
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MF Superior Products to send foreground-only driver location updates."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow MF Superior Products to protect your signed-in session."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b28781fa-dd92-41cd-9363-e0860729a811"
      }
    },
    "owner": "tylerdevries222",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b28781fa-dd92-41cd-9363-e0860729a811",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
