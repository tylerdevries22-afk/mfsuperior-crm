{
  "expo": {
    "name": "MF Superior Products",
    "slug": "mfsuperior-products",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/mf-logo-mark.png",
    "scheme": "mfsuperior",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0F0C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mfsuperior.products"
    },
    "android": {
      "package": "com.mfsuperior.products",
      "adaptiveIcon": {
        "backgroundColor": "#111315",
        "foregroundImage": "./assets/brand/mf-logo-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/mf-logo-mark.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MF Superior Products to attach freight photos.",
          "cameraPermission": "Allow MF Superior Products to take proof-of-delivery photos when you choose to."
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MF Superior Products to send foreground-only driver location updates."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow MF Superior Products to protect your signed-in session."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
