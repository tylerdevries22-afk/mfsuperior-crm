{
  "name": "mf-superior-products-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.112.3",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-battery": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8082",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "verify:demo": "node scripts/verify-demo-release.mjs && node scripts/verify-client-environment.cjs",
    "verify:demo:bundle": "node scripts/verify-demo-bundle.mjs",
    "build": "expo export --platform all --output-dir dist",
    "eas:build:demo": "npx eas-cli@latest build --profile demo --platform ios",
    "eas:build:demo:testflight": "npx eas-cli@latest build --profile demo --platform ios --auto-submit-with-profile production",
    "eas:build:production": "npx eas-cli@latest build --profile production --platform ios",
    "eas:update:demo": "npm run verify:demo && npm run build:demo && npm run verify:demo:bundle -- dist-demo && EXPO_PUBLIC_DEMO_AUTH_ENABLED=true npx eas-cli@latest update --channel demo --environment preview --input-dir dist-demo --skip-bundler --message \"Demo update\"",
    "eas:update:production": "npx eas-cli@latest update --channel production --environment production --message \"Production update\"",
    "build:demo": "EXPO_NO_DOTENV=1 EXPO_PUBLIC_DEMO_AUTH_ENABLED=true expo export --platform all --output-dir dist-demo"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/dist-[^/]+/"
    ]
  }
}
