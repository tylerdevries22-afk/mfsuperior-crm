{
  "name": "mf-superior-products-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.112.3",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-battery": "~10.0.8",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "^15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start --port 8082",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "verify:demo": "node scripts/verify-demo-release.mjs",
    "verify:demo:bundle": "node scripts/verify-demo-bundle.mjs",
    "build": "expo export --platform all --output-dir dist",
    "eas:build:demo": "npx eas-cli@latest build --profile demo --platform ios",
    "eas:build:demo:testflight": "npx eas-cli@latest build --profile demo --platform ios --auto-submit-with-profile production",
    "eas:build:production": "npx eas-cli@latest build --profile production --platform ios",
    "eas:update:demo": "EXPO_PUBLIC_DEMO_AUTH_ENABLED=true npx eas-cli@latest update --channel demo --message \"Demo update\"",
    "eas:update:production": "npx eas-cli@latest update --channel production --message \"Production update\""
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
